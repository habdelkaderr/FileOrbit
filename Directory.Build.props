<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Company>FileOrbit</Company>
    <Product>FileOrbit</Product>
    <Copyright>Copyright © 2026 FileOrbit contributors</Copyright>
    <Deterministic>true</Deterministic>
    <!-- packages.lock.json pins every dependency's version and content hash; CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- FileOrbit ships for 64-bit Windows; listing it keeps lock files stable for builds and publishes. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The portable build is a single-file exe. Analysing for it in every build also keeps normal builds and
         publishes on the same dependency set, so packages.lock.json is identical locally and in CI. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
  </PropertyGroup>
</Project>
