<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Radial menu surfaces: dark, slightly translucent, restrained. -->
    <SolidColorBrush x:Key="OrbitDiscBrush" Color="#EB1F1F23" />
    <SolidColorBrush x:Key="OrbitDiscStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="OrbitHubBrush" Color="#FF2B2B31" />
    <SolidColorBrush x:Key="OrbitHubStrokeBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="OrbitSegmentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="OrbitSegmentHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="OrbitSeparatorBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="OrbitTextBrush" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="OrbitSubtleTextBrush" Color="#FFA9A9B2" />
    <SolidColorBrush x:Key="OrbitBadgeBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="OrbitWarningBrush" Color="#FFFCD34D" />
    <SolidColorBrush x:Key="OrbitErrorBrush" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="OrbitSuccessBrush" Color="#FF6EE7B7" />
    <SolidColorBrush x:Key="OrbitAccentBrush" Color="#FF99B4FF" />
    <SolidColorBrush x:Key="OrbitAccentStrongBrush" Color="#FF6C8CFF" />
    <SolidColorBrush x:Key="OrbitAccentSoftBrush" Color="#406C8CFF" />
    <SolidColorBrush x:Key="OrbitAccentPressedBrush" Color="#666C8CFF" />
    <Color x:Key="OrbitShadowColor">#FF000000</Color>

    <!-- Per-category tints, used sparingly for icons only. -->
    <SolidColorBrush x:Key="CategoryDocumentBrush" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="CategorySpreadsheetBrush" Color="#FF81C995" />
    <SolidColorBrush x:Key="CategoryPresentationBrush" Color="#FFF6AE7B" />
    <SolidColorBrush x:Key="CategoryImageBrush" Color="#FFC58AF9" />
    <SolidColorBrush x:Key="CategoryAudioBrush" Color="#FFF28B82" />
    <SolidColorBrush x:Key="CategoryVideoBrush" Color="#FFFF8BCB" />
    <SolidColorBrush x:Key="CategoryArchiveBrush" Color="#FFFDD663" />
    <SolidColorBrush x:Key="CategoryTextDataBrush" Color="#FF78D9EC" />
    <SolidColorBrush x:Key="CategoryOtherBrush" Color="#FFBDC1C6" />
</ResourceDictionary>
