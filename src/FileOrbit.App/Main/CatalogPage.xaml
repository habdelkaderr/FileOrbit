<UserControl x:Class="FileOrbit.App.Main.CatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,0,24,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Conversion catalog" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Summary" Style="{StaticResource PageSubtitle}" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" TextChanged="OnFilterChanged" AutomationProperties.Name="Search conversions"
                         ToolTip="Search, e.g. “pdf”, “to png”, “ffmpeg”" />
                <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Category" />
                <CheckBox x:Name="AvailableOnly" Grid.Column="2" Content="Available only" Margin="12,0,0,0" VerticalAlignment="Center"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            </Grid>
        </StackPanel>
        <ListView x:Name="CatalogList" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="From" Width="90" DisplayMemberBinding="{Binding From}" />
                    <GridViewColumn Header="Action" Width="150" DisplayMemberBinding="{Binding ActionText}" />
                    <GridViewColumn Header="Engine" Width="170" DisplayMemberBinding="{Binding Engine}" />
                    <GridViewColumn Header="Fidelity" Width="150" DisplayMemberBinding="{Binding Fidelity}" />
                    <GridViewColumn Header="Status" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" ToolTip="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
