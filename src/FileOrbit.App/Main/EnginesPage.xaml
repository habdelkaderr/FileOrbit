<UserControl x:Class="FileOrbit.App.Main.EnginesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel Margin="0,0,24,24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Check again" Click="OnRefresh" VerticalAlignment="Center" />
                <TextBlock Text="Engines" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="FileOrbit uses software built into Windows and itself, plus optional programs you install. It never downloads or installs anything on its own." />
            <ItemsControl x:Name="PluginProblems" Visibility="Collapsed" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource OrbitWarningBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding AssemblyName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Subtle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EngineList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}" FontSize="18" Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Top" Margin="0,2,14,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Background="{DynamicResource OrbitBadgeBrush}" CornerRadius="4" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="Install with winget…" Click="OnInstall" Tag="{Binding}" Margin="0,0,0,6"
                                            Visibility="{Binding CanInstall, Converter={StaticResource Visible}}" />
                                    <Button Content="Locate…" Click="OnLocate" Tag="{Binding}" Margin="0,0,0,6"
                                            Visibility="{Binding CanLocate, Converter={StaticResource Visible}}" ToolTip="Point FileOrbit at an installed copy" />
                                    <Button Content="Website" Click="OnWebsite" Tag="{Binding}"
                                            Visibility="{Binding HasWebsite, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
