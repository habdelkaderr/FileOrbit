<Window x:Class="FileOrbit.App.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileOrbit"
        Width="1000" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/FileOrbit;component/Assets/FileOrbit.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Margin="10,12,6,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,18">
                <Image Source="pack://application:,,,/FileOrbit;component/Assets/FileOrbit.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="FileOrbit" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Bottom" CornerRadius="6" Padding="10,8" Margin="4,8,4,0" Background="{DynamicResource OrbitBadgeBrush}"
                    ToolTip="FileOrbit converts files with software on this PC. Files are never uploaded and there is no telemetry.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource OrbitSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Processed locally" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" SelectionChanged="OnNavigate"
                     AutomationProperties.Name="Navigation">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="{Binding Title}" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource OrbitAccentStrongBrush}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page host -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="12,8,0,0" Focusable="False" />

        <!-- Drop overlay -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource OrbitAccentSoftBrush}"
                BorderBrush="{DynamicResource OrbitAccentBrush}" BorderThickness="2" CornerRadius="8" Margin="8" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="Drop to open the FileOrbit menu" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
