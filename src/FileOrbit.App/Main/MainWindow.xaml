<Window x:Class="FileOrbit.App.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileOrbit"
        Width="1000" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        UseLayoutRounding="True"
        Background="{DynamicResource MacWindowBrush}"
        Foreground="{DynamicResource MacLabelBrush}"
        FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/FileOrbit;component/Assets/FileOrbit.ico">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/FileOrbit;component/Themes/Apple.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource MacSidebarBrush}" BorderBrush="{DynamicResource MacSeparatorBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,20">
                    <Image Source="pack://application:,,,/FileOrbit;component/Assets/FileOrbit.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FileOrbit" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,8,4,0"
                            ToolTip="FileOrbit converts files with software on this PC. Files are never uploaded and there is no telemetry.">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource MacSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Processed locally" FontSize="12" Foreground="{DynamicResource MacSecondaryLabelBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="OnNavigate"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                                           Visibility="{Binding BadgeVisibility}" />
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center" Width="20" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page host -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="28,22,0,0" Focusable="False" />

        <!-- Drop overlay -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource MacAccentSoftBrush}"
                BorderBrush="{DynamicResource MacAccentBrush}" BorderThickness="2" CornerRadius="12" Margin="8" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource MacAccentBrush}" />
                <TextBlock Text="Drop to open the FileOrbit menu" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
