<Window x:Class="FileOrbit.App.Conversion.ConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileOrbit"
        Width="480"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/FileOrbit;component/Assets/FileOrbit.ico">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source → target -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,12,0">
                <Image x:Name="SourceImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="SourceGlyph" Style="{StaticResource GlyphText}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SourceName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SourceMeta" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE72A;" Style="{StaticResource GlyphText}" FontSize="14" Opacity="0.6" VerticalAlignment="Center" Margin="12,0" />
            <Border Grid.Column="3" CornerRadius="8" Padding="12,6" Background="{DynamicResource OrbitAccentSoftBrush}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TargetGlyph" Style="{StaticResource GlyphText}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TargetName" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fidelity / caveats -->
        <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="6" Padding="12,9" Background="{DynamicResource OrbitBadgeBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FidelityGlyph" Style="{StaticResource GlyphText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="FidelityTitle" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="FidelityNote" Style="{StaticResource Caption}" Margin="21,3,0,0" />
                <TextBlock x:Name="PrivacyNote" Style="{StaticResource Caption}" Margin="21,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Batch list -->
        <Border x:Name="BatchPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource OrbitSeparatorBrush}">
            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BatchList" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Input.FileName}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                    <TextBlock Text="{Binding Message}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ProgressBar Grid.Column="1" Height="4" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5" VerticalAlignment="Center" MinWidth="64" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Setup -->
        <StackPanel x:Name="SetupPanel" Grid.Row="3" Margin="0,14,0,0">
            <Grid x:Name="EngineRow" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Engine" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="EngineBox" Grid.Column="1" DisplayMemberPath="Display" SelectionChanged="OnEngineChanged"
                          AutomationProperties.Name="Conversion engine" />
            </Grid>

            <StackPanel x:Name="OptionsPanel" />
            <Expander x:Name="AdvancedExpander" Header="More options" Margin="0,2,0,8" Visibility="Collapsed">
                <StackPanel x:Name="AdvancedPanel" Margin="0,8,0,0" />
            </Expander>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Save to" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FolderBox" Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="Output folder" />
                <Button Grid.Column="2" Content="Change…" Margin="8,0,0,0" Click="OnChangeFolder" />
            </Grid>

            <Grid x:Name="NameRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnNameChanged" AutomationProperties.Name="Output file name" />
                <TextBlock x:Name="ExtensionText" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
            </Grid>

            <Grid x:Name="ConflictRow" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="If it exists" Style="{StaticResource FieldLabel}" />
                <StackPanel Grid.Column="1">
                    <ComboBox x:Name="CollisionBox" SelectionChanged="OnCollisionChanged" AutomationProperties.Name="When the output already exists" />
                    <TextBlock x:Name="ConflictText" Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{DynamicResource OrbitWarningBrush}" Opacity="1" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="SetupError" Margin="0,10,0,0" Foreground="{DynamicResource OrbitErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- Password -->
        <StackPanel x:Name="PasswordPanel" Grid.Row="4" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource GlyphText}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="PasswordPrompt" FontWeight="SemiBold" Text="This file is password protected." />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="22,2,0,8" Text="The password is used only for this conversion and is never stored." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" KeyDown="OnPasswordKeyDown" />
                <Button Grid.Column="1" Content="Unlock and convert" Margin="8,0,0,0" Click="OnUnlock" />
            </Grid>
        </StackPanel>

        <!-- Progress and result -->
        <StackPanel x:Name="StatusPanel" Grid.Row="5" Margin="0,16,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusGlyph" Style="{StaticResource GlyphText}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock x:Name="PercentText" Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" />
            </Grid>
            <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1" />
            <TextBlock x:Name="StageText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <ItemsControl x:Name="WarningsList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource OrbitWarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" MaxWidth="400" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander x:Name="DetailsExpander" Header="Technical details" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,6,0,0" />
            </Expander>
        </StackPanel>

        <!-- Buttons -->
        <WrapPanel Grid.Row="6" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button x:Name="OpenFileButton" Content="Open file" Margin="8,0,0,0" Click="OnOpenFile" Visibility="Collapsed" />
            <Button x:Name="OpenFolderButton" Content="Show in folder" Margin="8,0,0,0" Click="OnOpenFolder" Visibility="Collapsed" />
            <Button x:Name="AgainButton" Content="Convert again" Margin="8,0,0,0" Click="OnConvertAgain" Visibility="Collapsed" />
            <Button x:Name="CopyDetailsButton" Content="Copy details" Margin="8,0,0,0" Click="OnCopyDetails" Visibility="Collapsed" />
            <Button x:Name="RetryButton" Content="Retry" Margin="8,0,0,0" Click="OnRetry" Visibility="Collapsed" />
            <Button x:Name="BackgroundButton" Content="Run in background" Margin="8,0,0,0" Click="OnRunInBackground" Visibility="Collapsed" />
            <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
            <Button x:Name="ConvertButton" Content="Convert" Margin="8,0,0,0" MinWidth="96" Click="OnConvert" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
        </WrapPanel>
    </Grid>
</Window>
