<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:radial="clr-namespace:FileOrbit.App.Radial">

    <Style TargetType="{x:Type radial:RadialSegment}">
        <Setter Property="Background" Value="{DynamicResource OrbitSegmentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        <Setter Property="ToolTipService.Placement" Value="Mouse" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type radial:RadialSegment}">
                    <Canvas Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Path x:Name="Shape"
                              Data="{TemplateBinding SegmentGeometry}"
                              Fill="{TemplateBinding Background}"
                              Stroke="{DynamicResource OrbitSeparatorBrush}"
                              StrokeThickness="1" />
                        <StackPanel x:Name="LabelPanel"
                                    Canvas.Left="{TemplateBinding LabelLeft}"
                                    Canvas.Top="{TemplateBinding LabelTop}"
                                    Width="{TemplateBinding LabelWidth}"
                                    IsHitTestVisible="False">
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Glyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="{TemplateBinding GlyphBrush}"
                                           HorizontalAlignment="Center" />
                                <Ellipse x:Name="FavoriteDot" Width="6" Height="6" Fill="{DynamicResource OrbitAccentBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-8,0" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Text="{TemplateBinding Label}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CaptionText"
                                       Text="{TemplateBinding Caption}"
                                       Foreground="{DynamicResource OrbitSubtleTextBrush}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource OrbitSegmentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource OrbitAccentSoftBrush}" />
                            <Setter TargetName="Shape" Property="Stroke" Value="{DynamicResource OrbitAccentBrush}" />
                            <Setter TargetName="Shape" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource OrbitAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsFavorite" Value="True">
                            <Setter TargetName="FavoriteDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsUnavailable" Value="True">
                            <Setter TargetName="LabelPanel" Property="Opacity" Value="0.55" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{DynamicResource OrbitWarningBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
