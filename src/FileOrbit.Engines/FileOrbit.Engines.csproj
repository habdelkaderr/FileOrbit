<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows build for the WPF app; plain net10.0 build for macOS (Windows-only engines left out). -->
    <TargetFrameworks>$(WindowsTargetFramework);net10.0</TargetFrameworks>
    <RootNamespace>FileOrbit.Engines</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(WindowsTargetFramework)'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != '$(WindowsTargetFramework)'">
    <!-- Built on Windows components (Office COM, WinRT PDF/OCR/imaging, Media Foundation, Job Objects). -->
    <Compile Remove="Office/OfficeEngine.cs;Office/StaWorker.cs;Office/OfficeProcessGuard.cs;Office/WordPdfPromptSuppressor.cs" />
    <Compile Remove="Pdf/WindowsPdfEngine.cs;Media/MediaFoundationEngine.cs;Ocr/WindowsOcrEngine.cs" />
    <Compile Remove="Images/WindowsImaging.cs;Processes/ChildProcessJob.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- U2-Net-P salient-object model (Apache-2.0, 4.6 MB) for background removal; embedded so it works offline. -->
    <EmbeddedResource Include="Models/u2netp.onnx" LogicalName="FileOrbit.Models.u2netp.onnx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileOrbit.Core\FileOrbit.Core.csproj" />
    <InternalsVisibleTo Include="FileOrbit.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
</Project>
