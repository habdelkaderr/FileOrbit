<?xml version="1.0" encoding="UTF-8"?>
<!--
  FileOrbit per-user installer. No administrator rights are needed; everything lives under the
  user's profile and HKEY_CURRENT_USER and is removed again on uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="FileOrbit"
           Manufacturer="FileOrbit"
           Version="$(var.ProductVersion)"
           UpgradeCode="7C9D2E4A-1F3B-4A6E-9C2D-5B8E0F1A2C3D"
           Scope="perUser"
           Compressed="yes">
    <SummaryInformation Description="FileOrbit - radial file conversion for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of FileOrbit is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FileOrbitIcon" SourceFile="$(var.RepoRoot)\src\FileOrbit.App\Assets\FileOrbit.ico" />
    <Property Id="ARPPRODUCTICON" Value="FileOrbitIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Radial file conversion for Windows. Files are processed locally." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FileOrbit" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- The portable folder's "START HERE.txt" describes the zip download; the installer doesn't need it. -->
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)START HERE.txt" />
      </Files>
    </ComponentGroup>

    <!-- Start menu shortcut (with the app's AppUserModelID so Windows groups its notifications). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="FileOrbitShortcut" Name="FileOrbit" Description="Convert files with a radial menu"
                  Target="[INSTALLFOLDER]FileOrbit.exe" WorkingDirectory="INSTALLFOLDER" Icon="FileOrbitIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="FileOrbit.App" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\FileOrbit\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Explorer "Convert with FileOrbit" for files and folders. Owned by the installer so uninstall removes it. -->
    <Component Id="ExplorerIntegration" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Classes\*\shell\FileOrbit">
        <RegistryValue Type="string" Value="Convert with FileOrbit" KeyPath="yes" />
        <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]FileOrbit.exe&quot;,0" />
        <RegistryValue Name="MultiSelectModel" Type="string" Value="Player" />
        <RegistryKey Key="command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]FileOrbit.exe&quot; --open &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FileOrbit">
        <RegistryValue Type="string" Value="Compress with FileOrbit" />
        <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]FileOrbit.exe&quot;,0" />
        <RegistryValue Name="MultiSelectModel" Type="string" Value="Player" />
        <RegistryKey Key="command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]FileOrbit.exe&quot; --open &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- Close a running FileOrbit (it lives in the notification area) before files are replaced or removed. -->
    <util:CloseApplication Id="CloseFileOrbit" Target="FileOrbit.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" />

    <!-- On uninstall, also remove what FileOrbit wrote at run time (the start-with-Windows entry). -->
    <CustomAction Id="UnregisterShell" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]FileOrbit.exe&quot; --unregister-shell"
                  Execute="immediate" Return="ignore" />
    <!-- Start FileOrbit when an interactive install finishes, like most downloaded programs do. -->
    <CustomAction Id="LaunchFileOrbit" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]FileOrbit.exe&quot; --main"
                  Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterShell" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchFileOrbit" After="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt; 3" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="FileOrbit" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ExplorerIntegration" />
    </Feature>
  </Package>
</Wix>
